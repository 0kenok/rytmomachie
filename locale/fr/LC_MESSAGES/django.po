#: templates/game/home.html:39
msgid "Defaults: 12 pieces, or a value of 500."
msgstr "Par défaut : 12 pièces, ou une valeur de 500."

#: templates/game/home.html:42
msgid "Start game"
msgstr "Commencer la partie"

