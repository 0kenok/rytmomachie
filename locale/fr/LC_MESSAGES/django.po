#: forms.py:10
msgid "De corpore: capture a number of pieces"
msgstr "De corpore : prendre un nombre de pièces"

#: forms.py:11
msgid "De bonis: capture pieces worth a total value"
msgstr "De bonis : prendre des pièces d'une valeur totale"

#: forms.py:12
msgid "Victoria magna: three pieces in progression in the enemy half"
msgstr "Victoria magna : trois pièces en progression dans la moitié adverse"

#: forms.py:21
msgid ""
"Pieces (de corpore) or total value (de bonis). Leave empty for the default."
msgstr "Nombre de pièces (de corpore) ou valeur totale (de bonis). Laissez vide pour la valeur par défaut."

#: models.py:18
msgid "Same screen (hot seat)"
msgstr "Même écran (chacun son tour)"

#: models.py:19
msgid "Two browsers (share a link)"
msgstr "Deux navigateurs (partager un lien)"

#: templates/game/base.html:13 templates/game/home.html:16
msgid "New game"
msgstr "Nouvelle partie"

#: templates/game/base.html:14 templates/game/rules.html:3
msgid "Rules"
msgstr "Règles"

#: templates/game/game.html:3
msgid "Game"
msgstr "Partie"

#: templates/game/game.html:8
msgid "Game board"
msgstr "Plateau de jeu"

#: templates/game/game.html:12
msgid "Loading…"
msgstr "Chargement…"

#: templates/game/game.html:16
msgid "Invite your opponent"
msgstr "Invitez votre adversaire"

#: templates/game/game.html:17
msgid "Send this link to the person playing Black:"
msgstr "Envoyez ce lien à la personne qui joue les Noirs :"

#: templates/game/game.html:20
msgid "Copy"
msgstr "Copier"

#: templates/game/game.html:22
msgid "Keep your own page URL private. It holds your White key."
msgstr "Ne partagez pas l'adresse de votre propre page : elle contient votre clé des Blancs."

#: templates/game/game.html:25
msgid "You are watching this game as a spectator."
msgstr "Vous regardez cette partie en tant que spectateur."

#: templates/game/game.html:31
msgid "Taken by White"
msgstr "Prises des Blancs"

#: templates/game/game.html:32
msgid "Taken by Black"
msgstr "Prises des Noirs"

#: templates/game/game.html:37
msgid "Moves"
msgstr "Coups"

#: templates/game/game.html:41
msgid "Resign"
msgstr "Abandonner"

#: templates/game/home.html:5
msgid "The philosophers' game"
msgstr "Le jeu des philosophes"

#: templates/game/home.html:6
msgid ""
"Rythmomachie (<em>rithmomachia</em>) is a medieval board game of numbers. "
"White plays the even numbers and Black the odd ones. You capture pieces by "
"equality, multiplication, addition, or by surrounding them."
msgstr "La rythmomachie (<em>rithmomachia</em>) est un jeu de plateau médiéval fondé sur les nombres. Les Blancs jouent les nombres pairs, les Noirs les impairs. On prend les pièces par égalité, multiplication, addition, ou en les encerclant."

#: templates/game/home.html:11
msgid "Read the rules"
msgstr "Lire les règles"

#: templates/game/home.html:20
msgid "Players"
msgstr "Joueurs"

#: templates/game/home.html:26
msgid "Victory condition"
msgstr "Condition de victoire"

#: templates/game/home.html:30
msgid "Target"
msgstr "Objectif"

#: templates/game/home.html:32
msgid "Defaults: 12 pieces, or a value of 500."
msgstr "Par défaut : 12 pièces, ou une valeur de 500."

#: templates/game/home.html:35
msgid "Start game"
msgstr "Commencer la partie"

#: views.py:18
msgid "The game is over."
msgstr "La partie est terminée."

#: views.py:19
msgid "There is no piece on that square."
msgstr "Il n'y a aucune pièce sur cette case."

#: views.py:20
msgid "It is not your turn."
msgstr "Ce n'est pas votre tour."

#: views.py:21
msgid "That piece cannot move there."
msgstr "Cette pièce ne peut pas aller là."

#: views.py:43
msgid "White"
msgstr "Blancs"

#: views.py:44
msgid "Black"
msgstr "Noirs"

#: views.py:45
msgid "circle"
msgstr "cercle"

#: views.py:46
msgid "triangle"
msgstr "triangle"

#: views.py:47
msgid "square"
msgstr "carré"

#: views.py:48
msgid "pyramid"
msgstr "pyramide"

#: views.py:49
#, python-format
msgid "%(side)s %(shape)s %(value)s"
msgstr "%(shape)s %(value)s (%(side)s)"

#: views.py:50
msgid "move here"
msgstr "aller ici"

#: views.py:51
#, python-format
msgid "%(side)s to move"
msgstr "Aux %(side)s de jouer"

#: views.py:53
#, python-format
msgid "%(text)s: %(detail)s"
msgstr "%(text)s : %(detail)s"

#: views.py:54
#, python-format
msgid "%(piece)s: %(from)s → %(to)s"
msgstr "%(piece)s : %(from)s → %(to)s"

#: views.py:55
msgid "your turn"
msgstr "à vous"

#: views.py:56
msgid "waiting for your opponent…"
msgstr "en attente de votre adversaire…"

#: views.py:57
msgid "spectating"
msgstr "spectateur"

#: views.py:58
#, python-format
msgid "%(side)s wins: %(reason)s."
msgstr "Victoire des %(side)s : %(reason)s."

#: views.py:59
#, python-format
msgid "captured %(count)s pieces"
msgstr "%(count)s pièces prises"

#: views.py:60
#, python-format
msgid "captured pieces worth %(total)s"
msgstr "pièces prises d'une valeur de %(total)s"

#: views.py:61
#, python-format
msgid "arithmetic progression %(values)s"
msgstr "progression arithmétique %(values)s"

#: views.py:62
#, python-format
msgid "geometric progression %(values)s"
msgstr "progression géométrique %(values)s"

#: views.py:63
#, python-format
msgid "harmonic progression %(values)s"
msgstr "progression harmonique %(values)s"

#: views.py:64
msgid "captured every enemy piece"
msgstr "toutes les pièces adverses ont été prises"

#: views.py:65
msgid "the opponent has no legal moves"
msgstr "l'adversaire n'a plus aucun coup possible"

#: views.py:66
#, python-format
msgid "%(side)s resigned"
msgstr "les %(side)s ont abandonné"

#: views.py:67
#, python-format
msgid "First to capture %(target)s pieces. White %(white)s, Black %(black)s."
msgstr "Le premier à prendre %(target)s pièces l'emporte. Blancs %(white)s, Noirs %(black)s."

#: views.py:68
#, python-format
msgid "First to capture %(target)s in value. White %(white)s, Black %(black)s."
msgstr "Le premier à prendre une valeur de %(target)s l'emporte. Blancs %(white)s, Noirs %(black)s."

#: views.py:69
msgid "Line up three pieces in progression inside the enemy half."
msgstr "Alignez trois pièces en progression dans la moitié adverse."

#: views.py:70
#, python-format
msgid "took %(piece)s by %(rule)s"
msgstr "prise de %(piece)s par %(rule)s"

#: views.py:71
msgid "equality"
msgstr "égalité"

#: views.py:72
msgid "assault"
msgstr "assaut"

#: views.py:73
msgid "ambush"
msgstr "embuscade"

#: views.py:74
msgid "siege"
msgstr "siège"

#: views.py:75
msgid "Resign this game?"
msgstr "Abandonner cette partie ?"

#: views.py:76
msgid "Copied"
msgstr "Copié"

#: views.py:158 views.py:185
msgid "Invalid JSON."
msgstr "JSON invalide."

#: views.py:165
msgid "Expected 'from' and 'to' as [row, col]."
msgstr "Les champs « from » et « to » doivent être de la forme [ligne, colonne]."

#: views.py:190
msgid "You are not playing in this game."
msgstr "Vous ne jouez pas dans cette partie."